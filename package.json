{
  "name": "zak",
  "productName": "Zak",
  "version": "0.0.1",
  "private": true,
  "description": "Personal desktop browser built on castLabs Electron (Widevine).",
  "main": "./out/main/index.js",
  "author": "Zak",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "build:app": "electron-vite build",
    "build": "electron-vite build && electron-builder",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:win": "electron-vite build && electron-builder --win",
    "build:dir": "electron-vite build && electron-builder --dir",
    "test": "vitest run",
    "test:e2e": "electron-vite build && playwright test",
    "release:check": "node scripts/release-check.js",
    "release:mac": "node scripts/release-check.js && npm run build:mac",
    "release:win": "node scripts/release-check.js && npm run build:win",
    "smoke:packaged": "ZAK_SKIP_VMP=1 CSC_IDENTITY_AUTO_DISCOVERY=false npm run build:dir && node tests/e2e/packaged.smoke.cjs"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "2.20.3",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "better-sqlite3": "13.2.0",
    "electron-chrome-extensions": "4.10.0",
    "electron-chrome-web-store": "0.13.0",
    "electron-store": "12.0.0",
    "electron-updater": "6.8.11",
    "tldts-experimental": "7.5.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/better-sqlite3": "9.6.0",
    "@types/chrome": "^0.0.287",
    "@types/node": "22.20.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.3.0",
    "axe-core": "^4.14.1",
    "electron": "github:castlabs/electron-releases#v45.2.1+wvcus",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "emoji-picker-react": "5.1.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "zustand": "5.1.0"
  },
  "overrides": {
    "adm-zip": "^0.6.1",
    "minimatch@>=7.0.0 <11.0.1": "^11.0.1"
  }
}
