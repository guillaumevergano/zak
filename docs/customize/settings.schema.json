{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/guillaumevergano/zak/main/docs/customize/settings.schema.json",
  "title": "Zak settings",
  "description": "Zak's settings file (config.json in Zak's profile folder; Settings → Customize → Open the settings file). Zak applies changes as soon as the file is saved. Unknown or invalid values fall back to their default.",
  "type": "object",
  "properties": {
    "general": {
      "type": "object",
      "properties": {
        "language": { "enum": ["system", "en", "fr", "es", "de", "it", "pt"], "default": "system", "description": "Interface language; applied at the next launch." },
        "searchEngine": { "enum": ["google", "duckduckgo", "brave", "bing", "qwant", "ecosia"], "default": "google" },
        "startup": { "enum": ["restore", "newtab"], "default": "restore", "description": "Reopen the last session's tabs, or start on a new tab." },
        "theme": { "enum": ["system", "light", "dark"], "default": "light" },
        "downloadDir": { "type": "string", "description": "Absolute path of the downloads folder. Defaults to the system's Downloads folder." },
        "askWhereToSave": { "type": "boolean", "default": false, "description": "Ask where to save each download instead of saving it straight into downloadDir." },
        "safeBrowsing": { "type": "boolean", "default": true, "description": "Warn before opening known phishing or malware pages." },
        "savePasswords": { "type": "boolean", "default": true, "description": "Offer to save passwords after a sign-in." },
        "sleepTabsAfter": { "enum": [0, 15, 30, 60, 120], "default": 0, "description": "Minutes before a background tab is unloaded; 0 = never." },
        "newtabHeadline": { "enum": ["zak", "custom", "quote", "proverb", "history", "wikipedia", "none"], "default": "zak", "description": "Under the new tab page logo: Zak's words, newtabTitle/newtabSubtitle, a quote, a proverb, on this day in history or a random article (Wikipedia, in Zak's language), or nothing." },
        "newtabTitle": { "type": "string", "maxLength": 80, "default": "" },
        "newtabSubtitle": { "type": "string", "maxLength": 120, "default": "" }
      },
      "additionalProperties": false
    },
    "pip": {
      "type": "object",
      "description": "Automatic picture-in-picture when leaving a tab that plays a video.",
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "closeOnReturn": { "type": "boolean", "default": true },
        "skipMuted": { "type": "boolean", "default": false },
        "excludedDomains": { "type": "array", "items": { "type": "string" }, "description": "Domains (subdomains included) where it never triggers, e.g. \"youtube.com\"." }
      }
    },
    "sidebar": {
      "type": "object",
      "properties": {
        "width": { "type": "number", "minimum": 220, "maximum": 380, "default": 300 },
        "collapsed": { "type": "boolean", "default": false, "description": "Icons-only sidebar (⌘B)." },
        "side": { "enum": ["left", "right"], "default": "right", "description": "Which side of the page the sidebar sits on." },
        "tabs": {
          "enum": ["top", "sidebar"],
          "default": "top",
          "description": "Tabs in the strip at the top of the window, or one per row in the sidebar (under the folders)."
        }
      }
    },
    "appearance": {
      "type": "object",
      "description": "Zak's own colors and fonts (zak://appearance, MCP update_appearance): only what differs from Zak's defaults. Applied at once, over a mod theme; private windows keep their colors.",
      "properties": {
        "colors": {
          "type": "object",
          "description": "Color tokens per theme. frame = tab strip and sidebar, cream = toolbar and Zak's pages, iris and pink = accents.",
          "properties": {
            "light": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "frame": { "$ref": "#/$defs/color" },
                "frame-2": { "$ref": "#/$defs/color" },
                "frame-3": { "$ref": "#/$defs/color" },
                "frame-line": { "$ref": "#/$defs/color" },
                "frame-text": { "$ref": "#/$defs/color" },
                "frame-sub": { "$ref": "#/$defs/color" },
                "frame-dim": { "$ref": "#/$defs/color" },
                "cream": { "$ref": "#/$defs/color" },
                "cream-2": { "$ref": "#/$defs/color" },
                "cream-edge": { "$ref": "#/$defs/color" },
                "cream-ink": { "$ref": "#/$defs/color" },
                "cream-sub": { "$ref": "#/$defs/color" },
                "cream-dim": { "$ref": "#/$defs/color" },
                "blush": { "$ref": "#/$defs/color" },
                "iris": { "$ref": "#/$defs/color" },
                "iris-ring": { "$ref": "#/$defs/color" },
                "pink": { "$ref": "#/$defs/color" },
                "pink-button": { "$ref": "#/$defs/color" },
                "pink-soft": { "$ref": "#/$defs/color" }
              }
            },
            "dark": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "frame": { "$ref": "#/$defs/color" },
                "frame-2": { "$ref": "#/$defs/color" },
                "frame-3": { "$ref": "#/$defs/color" },
                "frame-line": { "$ref": "#/$defs/color" },
                "frame-text": { "$ref": "#/$defs/color" },
                "frame-sub": { "$ref": "#/$defs/color" },
                "frame-dim": { "$ref": "#/$defs/color" },
                "cream": { "$ref": "#/$defs/color" },
                "cream-2": { "$ref": "#/$defs/color" },
                "cream-edge": { "$ref": "#/$defs/color" },
                "cream-ink": { "$ref": "#/$defs/color" },
                "cream-sub": { "$ref": "#/$defs/color" },
                "cream-dim": { "$ref": "#/$defs/color" },
                "blush": { "$ref": "#/$defs/color" },
                "iris": { "$ref": "#/$defs/color" },
                "iris-ring": { "$ref": "#/$defs/color" },
                "pink": { "$ref": "#/$defs/color" },
                "pink-button": { "$ref": "#/$defs/color" },
                "pink-soft": { "$ref": "#/$defs/color" }
              }
            }
          }
        },
        "fonts": {
          "type": "object",
          "description": "An installed font family, or null for Zak's own (DM Sans, Fraunces, JetBrains Mono).",
          "properties": {
            "ui": { "type": ["string", "null"], "description": "Interface: tabs, menus, settings." },
            "display": { "type": ["string", "null"], "description": "Titles: new tab, Zak's pages." },
            "mono": { "type": ["string", "null"], "description": "The address in the address bar, code." }
          }
        }
      }
    },
    "extensionBar": {
      "type": "object",
      "description": "Extension icons shown at the top of the sidebar.",
      "properties": {
        "order": { "type": "array", "items": { "type": "string" }, "description": "Extension ids, left to right." },
        "hidden": { "type": "array", "items": { "type": "string" }, "description": "Extension ids kept out of the sidebar." }
      }
    },
    "unpackedExtensions": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Absolute paths of folders loaded as unpacked Chrome extensions (each with a manifest.json). Zak reloads them when their files change."
    },
    "disabledExtensions": { "type": "array", "items": { "type": "string" }, "description": "Ids of extensions switched off." },
    "onboarded": { "type": "boolean", "description": "The welcome page has been shown." }
  },
  "$defs": {
    "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
  }
}
